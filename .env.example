# DevForge — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- LLM Configuration ---
# OpenAI API key (or compatible provider key)
LLM_API_KEY=

# Model to use (gpt-4o-mini recommended for speed + cost)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Optional: override base URL for local Ollama or other OpenAI-compatible endpoints
# Leave empty to use OpenAI's default endpoint.
# Example for Ollama: http://localhost:11434/v1
LLM_BASE_URL=

# --- Optional OpenRouter fallback ---
OPENROUTER_API_KEY=
LLM_PROVIDER=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Authentication ---
# Generate a unique secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_COOKIE_SECURE=false


DEBUG=false
