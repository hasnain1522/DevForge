# DevForge — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- LLM Configuration ---
# OpenAI API key (or compatible provider key)
LLM_API_KEY=sk-your-key-here

# Model to use (gpt-4o-mini recommended for speed + cost)
LLM_MODEL=gpt-4o-mini

# Optional: override base URL for local Ollama or other OpenAI-compatible endpoints
# Leave empty to use OpenAI's default endpoint.
# Example for Ollama: http://localhost:11434/v1
LLM_BASE_URL=

# --- Database ---
# SQLite database file path (relative to backend/ working directory)
DATABASE_URL=sqlite:///./devforge.db

# --- Application ---
DEBUG=false
